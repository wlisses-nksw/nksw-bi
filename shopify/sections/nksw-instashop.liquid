<section class="nksw-section">
  <div class="nksw-section-head" style="flex-direction:column;align-items:center;text-align:center;gap:6px">
    {%- if section.settings.eyebrow != blank -%}
      <div class="nksw-section-eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h2 class="nksw-section-title">{{ section.settings.title }}</h2>
  </div>

  <div class="nksw-instashop">
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.url | default: '#' }}"
        class="nksw-insta-tile"
        target="_blank"
        rel="noopener"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 600 }}"
            alt="{{ block.settings.image.alt | default: '@nakedswimwear' | escape }}"
            loading="lazy"
          />
        {%- elsif block.settings.product != blank -%}
          {%- assign insta_product = all_products[block.settings.product] -%}
          <img
            src="{{ insta_product.featured_image | image_url: width: 600 }}"
            alt="{{ insta_product.title | escape }}"
            loading="lazy"
          />
        {%- endif -%}
        <div class="nksw-insta-overlay">
          <svg width="22" height="22" fill="none" stroke="#fff" stroke-width="1.5" viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r=".7" fill="#fff"/>
          </svg>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "NKSW · Instashop",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@nakedswimwear · #NakedBabes" },
    { "type": "text", "id": "title",   "label": "Título",  "default": "Shop the feed" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image",   "label": "Imagem (prioridade)" },
        { "type": "product",      "id": "product", "label": "Produto (alternativo)" },
        { "type": "url",          "id": "url",     "label": "Link do post no Instagram" }
      ]
    }
  ],
  "presets": [{
    "name": "NKSW · Instashop",
    "blocks": [
      { "type": "post" }, { "type": "post" }, { "type": "post" },
      { "type": "post" }, { "type": "post" }, { "type": "post" }
    ]
  }]
}
{% endschema %}
